# AURA-SAR Environment Variables
# Copy to .env.local for local development

# Backend API (over EONET / Open-Meteo as the primary data source)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# Public real-data fallbacks (keyless, CORS-enabled; used when the backend is not configured)
#   Fires:     NASA EONET v3        https://eonet.gsfc.nasa.gov/api/v3/events?status=open&category=wildfires
#   Air quality: Open-Meteo Air Quality (US AQI)  https://air-quality-api.open-meteo.com/v1/air-quality

# SAR scene catalog (backend proxies ASF asf_search; frontend falls back to bundled mock catalog)
VITE_WEBSOCKET_URL=ws://localhost:3001/ws

# WebSocket for Real-time Alerts (optional)
VITE_WEBSOCKET_URL=ws://localhost:3001/ws

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REPORTING=true
VITE_ENABLE_CROWDSOURCING=true

# NASA/External APIs
VITE_NASA_API_KEY=
VITE_ASF_API_KEY=
VITE_GEE_PROJECT_ID=

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=