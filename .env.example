# AURA-SAR Environment Variables
# Copy to .env.local for local development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# Map Configuration
VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_URL_LIGHT=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://openstreetmap.org">OpenStreetMap</a>

# WebSocket for Real-time Updates
VITE_WEBSOCKET_URL=ws://localhost:3001/ws

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REPORTING=true
VITE_ENABLE_CROWDSOURCING=true

# NASA/External APIs
VITE_NASA_API_KEY=
VITE_ASF_API_KEY=
VITE_GEE_PROJECT_ID=

# Analytics
VITE_GA_MEASUREMENT_ID=